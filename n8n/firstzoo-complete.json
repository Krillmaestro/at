      "position": [200, 300],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v21.0/334560683076234/posts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "options": {}
      },
      "id": "posts-1",
      "name": "1. Hämta Posts",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 300],
      "typeVersion": 4.2,
      "credentials": {
        "facebookGraphApi": {
          "id": "ikTAM2ghOhky6wA6",
          "name": "Facebook Graph account"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $json.data[0].id }}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "options": {}
      },
      "id": "comments-1",
      "name": "2. Hämta Kommentarer",
      "type": "n8n-nodes-base.httpRequest",
      "position": [600, 300],
      "typeVersion": 4.2,
      "credentials": {
        "facebookGraphApi": {
          "id": "ikTAM2ghOhky6wA6",
          "name": "Facebook Graph account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "caseSensitive": true, "typeValidation": "loose"},
          "combinator": "and",
          "conditions": [{
            "id": "check-comments",
            "operator": {"type": "array", "operation": "notEmpty", "singleValue": true},
            "leftValue": "={{ $json.data }}",
            "rightValue": ""
          }]
        },
        "options": {}
      },
      "id": "check-1",
      "name": "3. Finns Kommentarer?",
      "type": "n8n-nodes-base.if",
      "position": [800, 300],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "jsCode": "// Hämta senaste kommentaren\nconst comments = $input.first().json.data || [];\n\nif (comments.length === 0) {\n  return [{ json: { error: 'Inga kommentarer' } }];\n}\n\n// Sortera efter datum (nyast först)\nconst sorted = comments.sort((a, b) => \n  new Date(b.created_time) - new Date(a.created_time)\n);\n\nconst latest = sorted[0];\n\nreturn [{\n  json: {\n    commentId: latest.id,\n    commentMessage: latest.message || '',\n    commentTime: latest.created_time,\n    fromName: latest.from?.name || 'Kund'\n  }\n}];"
      },
      "id": "extract-1",
      "name": "4. Extrahera Senaste",
      "type": "n8n-nodes-base.code",
      "position": [1000, 200],
      "typeVersion": 2
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {"__rl": true, "mode": "id", "value": "c19128967ed94e99898fb35495eb20ad"},
        "filterType": "manual",
        "filters": {
          "conditions": [{
            "key": "Comment ID|rich_text",
            "condition": "equals",
            "richTextValue": "={{ $json.commentId }}"
          }]
        },
        "options": {}
      },
      "id": "check-db-1",
      "name": "5. Redan Besvarad?",
      "type": "n8n-nodes-base.notion",
      "position": [1200, 200],
      "typeVersion": 2.2,
      "alwaysOutputData": true,
      "credentials": {
        "notionApi": {
          "id": "70eJ7d3xVXegEJH6",
          "name": "Notion account 3"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "caseSensitive": true, "typeValidation": "loose"},
          "combinator": "and",
          "conditions": [{
            "id": "check-new",
            "operator": {"type": "array", "operation": "empty", "singleValue": true},
            "leftValue": "={{ $json.results || [] }}",
            "rightValue": ""
          }]
        },
        "options": {}
      },
      "id": "is-new-1",
      "name": "6. Ny Kommentar?",
      "type": "n8n-nodes-base.if",
      "position": [1400, 200],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {"__rl": true, "mode": "id", "value": "252f4caadbf44136a31fa48541c3c604"},
        "returnAll": true,
        "options": {}
      },
      "id": "kb-1",
      "name": "7. Hämta Knowledge Base",
      "type": "n8n-nodes-base.notion",
      "position": [1600, 100],
      "typeVersion": 2.2,
      "credentials": {
        "notionApi": {
          "id": "70eJ7d3xVXegEJH6",
          "name": "Notion account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Hämta kommentar-info från tidigare steg\nconst commentData = $('4. Extrahera Senaste').first().json;\n\n// Hämta knowledge base\nconst kbItems = $input.all().map(item => {\n  const props = item.json.properties || {};\n  let name = '';\n  let desc = '';\n  let price = '';\n  \n  // Extrahera värden från Notion-properties\n  for (const [key, val] of Object.entries(props)) {\n    if (val.title && val.title[0]) name = val.title[0].plain_text || '';\n    if (val.rich_text && val.rich_text[0]) {\n      if (key.toLowerCase().includes('desc')) desc = val.rich_text[0].plain_text || '';\n      if (key.toLowerCase().includes('price') || key.toLowerCase().includes('pris')) price = val.rich_text[0].plain_text || '';\n    }\n  }\n  \n  return `${name}: ${desc} (${price})`;\n}).filter(x => x.length > 5);\n\nconst knowledgeContext = kbItems.join('\\n') || 'Ingen produktinfo tillgänglig.';\n\nreturn [{\n  json: {\n    commentId: commentData.commentId,\n    commentMessage: commentData.commentMessage,\n    knowledgeContext: knowledgeContext\n  }\n}];"
      },
      "id": "prepare-1",
      "name": "8. Förbered AI-prompt",
      "type": "n8n-nodes-base.code",
      "position": [1800, 100],
      "typeVersion": 2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Du är Sandra, kundservicemedarbetare på ApotekHunden/FirstZoo.\n\nSvara ALLTID på svenska, proffsigt och vänligt.\nMax 0-1 emoji. Aldrig: \"Tjena\", \"kompis\", \"gumman\", slang.\n\nPRODUKTINFO:\n- Probiotika 3-i-1: 1 miljard CFU, prebiotika, naturliga fibrer\n- Calm & Relax: lugnande, verkar inom 30-60 min\n- Hip & Joint: leder, brosk, seniorhundar\n\nKLARNA: Bara engångsköp, ej prenumeration.\nLEVERANS: Inom 24 timmar.\nPRIS: 359 kr lägsta pris. 50% gäller första månaden prenumeration.\n\nKUNSKAPSBAS:\n{{ $json.knowledgeContext }}\n\nKUNDENS KOMMENTAR:\n\"{{ $json.commentMessage }}\"\n\nSkriv ett kort, hjälpsamt svar. Avsluta med:\nMVH // Sandra, ApotekHunden",
        "options": {}
      },
      "id": "ai-1",
      "name": "9. AI Svarar",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [2000, 100],
      "typeVersion": 2.1
    },
