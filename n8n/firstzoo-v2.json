      "id": "comments-1",
      "name": "2. Hämta Kommentarer",
      "type": "n8n-nodes-base.httpRequest",
      "position": [600, 300],
      "typeVersion": 4.2,
      "credentials": {
        "facebookGraphApi": {
          "id": "ikTAM2ghOhky6wA6",
          "name": "Facebook Graph account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Hämta kommentarer\nconst comments = $input.first().json.data || [];\n\n// Filtrera: bara kommentarer med meddelande\nconst validComments = comments.filter(c => c.message && c.message.trim().length > 0);\n\nif (validComments.length === 0) {\n  // Inga giltiga kommentarer - stoppa workflow\n  return [];\n}\n\n// Sortera efter datum (nyast först)\nconst sorted = validComments.sort((a, b) => \n  new Date(b.created_time) - new Date(a.created_time)\n);\n\nconst latest = sorted[0];\n\n// Extrahera post ID från kommentar-ID (format: postId_commentId)\nconst parts = latest.id.split('_');\nconst postId = parts.length >= 2 ? parts.slice(0, -1).join('_') : latest.id;\n\nreturn [{\n  json: {\n    commentId: latest.id,\n    postId: postId,\n    commentMessage: latest.message,\n    commentTime: latest.created_time,\n    fromName: latest.from?.name || 'Kund'\n  }\n}];"
      },
      "id": "extract-1",
      "name": "3. Extrahera Giltig Kommentar",
      "type": "n8n-nodes-base.code",
      "position": [800, 300],
      "typeVersion": 2
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "caseSensitive": true, "typeValidation": "loose"},
          "combinator": "and",
          "conditions": [{
            "id": "check-msg",
            "operator": {"type": "string", "operation": "notEmpty"},
            "leftValue": "={{ $json.commentMessage }}",
            "rightValue": ""
          }]
        },
        "options": {}
      },
      "id": "check-valid-1",
      "name": "4. Har Meddelande?",
      "type": "n8n-nodes-base.if",
      "position": [1000, 300],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Du är Sandra, kundservicemedarbetare på ApotekHunden/FirstZoo, ett svenskt företag som säljer kosttillskott för hundar.\n\nSvara ALLTID på svenska, proffsigt och vänligt. Håll svaret kort (2-4 meningar).\nMax 0-1 emoji. Aldrig: \"Tjena\", \"kompis\", \"gumman\", slang.\n\nPRODUKTER:\n- Probiotika 3-i-1: 1 miljard CFU probiotika, prebiotika, naturliga fibrer. 359 kr.\n- Calm & Relax: Naturliga lugnande ingredienser, verkar inom 30-60 min. 359 kr.\n- Hip & Joint: Stöd för leder, brosk och seniorhundar. 359 kr.\n\nVIKTIG INFO:\n- Klarna: Bara engångsköp, ej prenumeration\n- Leverans: Normalt inom 24 timmar\n- 50% rabatt gäller endast första månaden med prenumeration\n- Vid problem: Be kunden maila eller skicka ordernummer\n\nKUNDENS KOMMENTAR:\n\"{{ $json.commentMessage }}\"\n\nSkriv ett kort, hjälpsamt och empatiskt svar. Avsluta alltid med:\nMVH // Sandra, ApotekHunden",
        "options": {}
      },
      "id": "ai-1",
      "name": "5. AI Svarar",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [1200, 200],
      "typeVersion": 2.1
    },
