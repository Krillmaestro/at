    {
      "parameters": {
        "jsCode": "// Hämta kommentarer\nconst comments = $input.first().json.data || [];\n\n// FILTRERA BORT TOMMA KOMMENTARER\nconst validComments = comments.filter(c => c.message && c.message.trim().length > 0);\n\nif (validComments.length === 0) {\n  return [];\n}\n\n// Sortera efter datum (nyast först)\nconst sorted = validComments.sort((a, b) => \n  new Date(b.created_time) - new Date(a.created_time)\n);\n\nconst latest = sorted[0];\n\nreturn [{\n  json: {\n    commentId: latest.id,\n    commentMessage: latest.message,\n    commentTime: latest.created_time,\n    fromName: latest.from?.name || 'Kund'\n  }\n}];"
      },
