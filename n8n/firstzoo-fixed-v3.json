    {
      "parameters": {
        "jsCode": "// Hämta kommentar-info från tidigare steg\nconst commentData = $('4. Extrahera Senaste').first().json;\n\n// Hämta knowledge base\nconst kbItems = $input.all().map(item => {\n  const props = item.json.properties || {};\n  let name = '';\n  let desc = '';\n  let price = '';\n  \n  for (const [key, val] of Object.entries(props)) {\n    if (val.title && val.title[0]) name = val.title[0].plain_text || '';\n    if (val.rich_text && val.rich_text[0]) {\n      if (key.toLowerCase().includes('desc')) desc = val.rich_text[0].plain_text || '';\n      if (key.toLowerCase().includes('price') || key.toLowerCase().includes('pris')) price = val.rich_text[0].plain_text || '';\n    }\n  }\n  \n  return name ? `${name}: ${desc} (${price})` : '';\n}).filter(x => x.length > 3);\n\nconst knowledgeContext = kbItems.join('\\n') || 'Probiotika 3-i-1: 359 kr. Calm & Relax: 359 kr. Hip & Joint: 359 kr.';\n\nreturn [{\n  json: {\n    commentId: commentData.commentId,\n    commentMessage: commentData.commentMessage,\n    knowledgeContext: knowledgeContext\n  }\n}];"
      },
