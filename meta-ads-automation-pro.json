      "id": "submit-form",
      "name": "Submit Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [-1400, 400],
      "webhookId": "meta-ads-form"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Parse folder ID from URL\nlet folderId = input['Google Drive Folder URL'];\nif (folderId.includes('folders/')) {\n  folderId = folderId.split('folders/')[1].split('?')[0].split('/')[0];\n}\n\n// Build UTM parameters\nlet websiteUrl = input['Website URL'];\nconst utmSource = input['UTM Source'] || 'facebook';\nconst utmMedium = input['UTM Medium'] || 'paid_social';\nconst utmCampaign = input['UTM Campaign'] || 'meta_ads';\n\n// Add UTM parameters to URL\nconst utmParams = `utm_source=${utmSource}&utm_medium=${utmMedium}&utm_campaign=${utmCampaign}`;\nif (websiteUrl.includes('?')) {\n  websiteUrl = `${websiteUrl}&${utmParams}`;\n} else {\n  websiteUrl = `${websiteUrl}?${utmParams}`;\n}\n\nreturn [{\n  json: {\n    folder_id: folderId,\n    campaign_id: input['Campaign ID'],\n    adset_id: input['Ad Set ID'],\n    primary_text: input['Primary Text'],\n    headline: input['Headline'],\n    description: input['Description'] || '',\n    website_url: websiteUrl,\n    website_url_raw: input['Website URL'],\n    call_to_action: input['Call to Action'],\n    utm_source: utmSource,\n    utm_medium: utmMedium,\n    utm_campaign: utmCampaign,\n    submission_time: new Date().toISOString()\n  }\n}];"
      },
      "id": "format-ad-copy",
      "name": "Format Ad Copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1160, 400]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "list"
        },
        "options": {}
      },
      "id": "get-settings",
      "name": "Get Settings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-920, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const formData = $('Format Ad Copy').first().json;\nconst settingsRows = $input.all();\n\n// Parse settings from sheet\nconst settings = {};\nfor (const row of settingsRows) {\n  if (row.json.Setting && row.json.Value !== undefined) {\n    settings[row.json.Setting] = row.json.Value;\n  }\n}\n\nreturn [{\n  json: {\n    ...formData,\n    ad_account_id: settings.ad_account_id || '',\n    facebook_page_id: settings.facebook_page_id || '',\n    slack_channel: settings.slack_channel || ''\n  }\n}];"
      },
      "id": "merge-settings",
      "name": "Merge Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-account",
              "leftValue": "={{ $json.ad_account_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "has-page",
              "leftValue": "={{ $json.facebook_page_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
