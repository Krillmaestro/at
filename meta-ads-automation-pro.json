      "parameters": {
        "jsCode": "const folderInfo = $input.first().json;\nconst prevData = $('Merge Settings').first().json;\n\n// Clean folder name for use as Ad Set name\nconst folderName = folderInfo.name;\nconst adSetName = folderName.replace(/[^a-zA-Z0-9åäöÅÄÖ\\s\\-_]/g, '').trim();\n\nconst timestamp = new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    ...prevData,\n    folder_name: folderName,\n    adset_name: `${adSetName}_${timestamp}`\n  }\n}];"
      },
