    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "=(mimeType='image/jpeg' or mimeType='image/png' or mimeType='image/webp' or mimeType='video/mp4' or mimeType='video/quicktime' or mimeType='video/mov') and '{{ $json.folder_id }}' in parents and trashed=false",
        "returnAll": true,
        "options": {
          "fields": ["id", "name", "mimeType", "size", "webViewLink"]
        }
      },
