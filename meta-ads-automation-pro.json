      "parameters": {
        "jsCode": "const allAds = $input.all();\n\n// Group by folder\nconst folders = {};\nfor (const ad of allAds) {\n  const folderId = ad.json.folder_id;\n  if (!folders[folderId]) {\n    folders[folderId] = {\n      folder_id: folderId,\n      folder_name: ad.json.folder_name,\n      adset_name: ad.json.adset_name,\n      adset_id: ad.json.adset_id,\n      ads: [],\n      config: ad.json.config\n    };\n  }\n  folders[folderId].ads.push({\n    name: ad.json.ad_name,\n    type: ad.json.media_type,\n    id: ad.json.ad_id\n  });\n}\n\nreturn Object.values(folders).map(f => ({ json: f }));"
      },
