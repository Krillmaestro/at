        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.form_data.campaign_name }}_AdSet_{{ $json.form_data.attribution_name }}_{{ $now.format('yyyy-MM-dd') }}\",\n  \"campaign_id\": \"{{ $json.campaign_id }}\",\n  \"status\": \"PAUSED\",\n  \"daily_budget\": {{ $json.form_data.daily_budget }},\n  \"billing_event\": \"IMPRESSIONS\",\n  \"optimization_goal\": \"OFFSITE_CONVERSIONS\",\n  \"bid_strategy\": \"LOWEST_COST_WITHOUT_CAP\",\n  \"attribution_spec\": [\n    {\n      \"event_type\": \"CLICK_THROUGH\",\n      \"window_days\": {{ $json.form_data.attribution_click }}\n    }{{ $json.form_data.attribution_view > 0 ? ',{\"event_type\": \"VIEW_THROUGH\", \"window_days\": ' + $json.form_data.attribution_view + '}' : '' }}\n  ],\n  \"promoted_object\": {\n    \"pixel_id\": \"{{ $json.form_data.pixel_id }}\",\n    \"custom_event_type\": \"{{ $json.form_data.conversion_event }}\"\n  },\n  \"targeting\": {\n    \"geo_locations\": {\n      \"countries\": {{ JSON.stringify($json.form_data.target_countries) }}\n    },\n    \"age_min\": 18,\n    \"age_max\": 65,\n    \"publisher_platforms\": [\"facebook\", \"instagram\"],\n    \"facebook_positions\": [\"feed\", \"video_feeds\", \"story\", \"reels\"],\n    \"instagram_positions\": [\"stream\", \"story\", \"reels\"]\n  }\n}",
