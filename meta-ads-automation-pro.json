      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const timestamp = new Date().toISOString().slice(0, 10).replace(/-/g, '');\n  const cleanName = item.json.clean_name;\n  const adName = `Video_${cleanName}_${timestamp}`;\n  \n  return {\n    json: {\n      ...item.json,\n      ad_name: adName,\n      media_type: 'video'\n    },\n    binary: item.binary\n  };\n});"
      },
