    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Parse folder ID from URL\nlet folderId = input['Google Drive Folder URL'];\nif (folderId.includes('folders/')) {\n  folderId = folderId.split('folders/')[1].split('?')[0].split('/')[0];\n}\n\n// Parse target countries\nconst countries = input['Target Countries'].split(',').map(c => c.trim().toUpperCase());\n\n// Build UTM parameters\nlet websiteUrl = input['Website URL'];\nconst utmSource = input['UTM Source'] || 'facebook';\nconst utmMedium = input['UTM Medium'] || 'paid_social';\nconst utmCampaign = input['UTM Campaign'] || input['Campaign Name'].toLowerCase().replace(/\\s+/g, '_');\n\n// Add UTM parameters to URL\nconst utmParams = `utm_source=${utmSource}&utm_medium=${utmMedium}&utm_campaign=${utmCampaign}`;\nif (websiteUrl.includes('?')) {\n  websiteUrl = `${websiteUrl}&${utmParams}`;\n} else {\n  websiteUrl = `${websiteUrl}?${utmParams}`;\n}\n\n// Map attribution window to Meta format\nconst attributionMap = {\n  '1d_click': { click: 1, view: 0, name: '1dc' },\n  '7d_click': { click: 7, view: 0, name: '7dc' },\n  '7d_click_1d_view': { click: 7, view: 1, name: '7dc1dv' }\n};\n\nconst attribution = attributionMap[input['Attribution Window']] || attributionMap['7d_click'];\n\nreturn [{\n  json: {\n    folder_id: folderId,\n    ad_account_id: input['Ad Account ID'].replace('act_', ''),\n    facebook_page_id: input['Facebook Page ID'],\n    campaign_name: input['Campaign Name'],\n    primary_text: input['Primary Text'],\n    headline: input['Headline'],\n    description: input['Description'] || '',\n    website_url: websiteUrl,\n    website_url_raw: input['Website URL'],\n    call_to_action: input['Call to Action'],\n    daily_budget: input['Daily Budget (cents)'],\n    target_countries: countries,\n    pixel_id: input['Pixel ID'],\n    conversion_event: input['Conversion Event'],\n    attribution_window: input['Attribution Window'],\n    attribution_click: attribution.click,\n    attribution_view: attribution.view,\n    attribution_name: attribution.name,\n    utm_source: utmSource,\n    utm_medium: utmMedium,\n    utm_campaign: utmCampaign,\n    submission_time: new Date().toISOString()\n  }\n}];"
      },
