      "parameters": {
        "jsCode": "const items = $input.all();\nconst creativeItems = $('Merge Creatives').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const creative = creativeItems[i];\n  \n  results.push({\n    json: {\n      ad_id: item.json.id,\n      ad_name: creative.json.ad_name,\n      creative_id: creative.json.creative_id,\n      adset_id: creative.json.form_data.adset_id,\n      campaign_id: creative.json.form_data.campaign_id,\n      media_type: creative.json.media_type,\n      form_data: creative.json.form_data,\n      status: 'CREATED'\n    }\n  });\n}\n\nreturn results;"
      },
