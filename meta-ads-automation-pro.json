      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 400]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst configData = $('Set AdSet Name').first().json;\n\nconst MAX_IMAGE_SIZE = 30 * 1024 * 1024; // 30MB\nconst MAX_VIDEO_SIZE = 4 * 1024 * 1024 * 1024; // 4GB\n\nconst validItems = [];\n\nfor (const item of items) {\n  const name = item.json.name;\n  const size = parseInt(item.json.size) || 0;\n  const mimeType = item.json.mimeType;\n  const isVideo = mimeType.includes('video');\n  \n  // Check file size\n  if (isVideo && size > MAX_VIDEO_SIZE) {\n    console.log(`Skipping ${name}: Video exceeds 4GB`);\n    continue;\n  }\n  if (!isVideo && size > MAX_IMAGE_SIZE) {\n    console.log(`Skipping ${name}: Image exceeds 30MB`);\n    continue;\n  }\n  \n  // Clean filename for ad name\n  const cleanName = name\n    .replace(/\\.[^/.]+$/, '') // Remove extension\n    .replace(/[^a-zA-Z0-9åäöÅÄÖ\\-_]/g, '_') // Replace special chars\n    .substring(0, 50); // Limit length\n  \n  validItems.push({\n    json: {\n      file_id: item.json.id,\n      file_name: name,\n      clean_name: cleanName,\n      mime_type: mimeType,\n      is_video: isVideo,\n      size: size,\n      config: configData\n    }\n  });\n}\n\nif (validItems.length === 0) {\n  throw new Error('Inga giltiga filer hittades i mappen');\n}\n\nreturn validItems;"
      },
