      "id": "get-settings",
      "name": "Get Settings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-1160, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const settingsRows = $input.all();\n\n// Parse settings from sheet into object\nconst settings = {};\nfor (const row of settingsRows) {\n  if (row.json.Setting && row.json.Value !== undefined && row.json.Value !== '') {\n    settings[row.json.Setting] = row.json.Value;\n  }\n}\n\n// Validate required settings\nconst required = [\n  'ad_account_id', \n  'facebook_page_id', \n  'pixel_id', \n  'campaign_id',\n  'creative_folder_id',\n  'uploaded_folder_id',\n  'daily_budget', \n  'target_countries',\n  'website_url',\n  'primary_text',\n  'headline',\n  'call_to_action'\n];\nconst missing = required.filter(key => !settings[key]);\n\nif (missing.length > 0) {\n  throw new Error('Saknade settings i Google Sheet: ' + missing.join(', '));\n}\n\n// Convert budget from KR to cents (öre)\nconst budgetKr = parseFloat(settings.daily_budget);\nconst budgetCents = Math.round(budgetKr * 100);\n\n// Parse countries\nconst countries = settings.target_countries.split(',').map(c => c.trim().toUpperCase());\n\nreturn [{\n  json: {\n    // Account\n    ad_account_id: settings.ad_account_id.replace('act_', ''),\n    facebook_page_id: settings.facebook_page_id,\n    pixel_id: settings.pixel_id,\n    campaign_id: settings.campaign_id,\n    \n    // Folders\n    creative_folder_id: settings.creative_folder_id,\n    uploaded_folder_id: settings.uploaded_folder_id,\n    \n    // Budget\n    daily_budget_kr: budgetKr,\n    daily_budget_cents: budgetCents,\n    \n    // Targeting\n    target_countries: countries,\n    optimization_goal: settings.optimization_goal || 'OFFSITE_CONVERSIONS',\n    conversion_event: settings.conversion_event || 'PURCHASE',\n    bid_strategy: settings.bid_strategy || 'LOWEST_COST_WITHOUT_CAP',\n    \n    // Ad Creative Content\n    website_url: settings.website_url,\n    primary_text: settings.primary_text,\n    headline: settings.headline,\n    description: settings.description || '',\n    call_to_action: settings.call_to_action,\n    \n    // Slack\n    slack_channel: settings.slack_channel || '',\n    \n    // Metadata\n    run_time: new Date().toISOString()\n  }\n}];"
      },
      "id": "parse-settings",
      "name": "Parse Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-920, 400]
    },
