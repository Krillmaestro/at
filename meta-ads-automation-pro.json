        "jsCode": "const items = $input.all();\nconst prevItems = $('Split Creatives for Ads').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const prevItem = prevItems[i];\n  \n  results.push({\n    json: {\n      ad_id: item.json.id,\n      ad_name: prevItem.json.ad_name,\n      creative_id: prevItem.json.creative_id,\n      adset_id: prevItem.json.adset_id,\n      campaign_id: prevItem.json.campaign_id,\n      media_type: prevItem.json.media_type,\n      form_data: prevItem.json.form_data,\n      status: 'CREATED'\n    }\n  });\n}\n\nreturn results;"
      },
