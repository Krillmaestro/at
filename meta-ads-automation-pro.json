      "id": "submit-form",
      "name": "Submit Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [-1400, 400],
      "webhookId": "meta-ads-form"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Parse folder ID from URL\nlet folderId = input['Google Drive Folder URL'];\nif (folderId.includes('folders/')) {\n  folderId = folderId.split('folders/')[1].split('?')[0].split('/')[0];\n}\n\nreturn [{\n  json: {\n    folder_id: folderId,\n    folder_url: input['Google Drive Folder URL'],\n    campaign_id: input['Campaign ID'].trim(),\n    primary_text: input['Primary Text (Annonstext)'],\n    headline: input['Headline (Rubrik)'],\n    description: input['Description (Beskrivning)'] || '',\n    website_url_override: input['Website URL (lämna tomt för default)'] || '',\n    call_to_action: input['Call to Action'],\n    submission_time: new Date().toISOString()\n  }\n}];"
      },
      "id": "format-form-data",
      "name": "Format Form Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1160, 400]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "list"
        },
        "options": {}
      },
      "id": "get-settings",
      "name": "Get Settings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-920, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const formData = $('Format Form Data').first().json;\nconst settingsRows = $input.all();\n\n// Parse settings from sheet into object\nconst settings = {};\nfor (const row of settingsRows) {\n  if (row.json.Setting && row.json.Value !== undefined && row.json.Value !== '') {\n    settings[row.json.Setting] = row.json.Value;\n  }\n}\n\n// Validate required settings\nconst required = ['ad_account_id', 'facebook_page_id', 'pixel_id', 'daily_budget', 'target_countries'];\nconst missing = required.filter(key => !settings[key]);\n\nif (missing.length > 0) {\n  throw new Error('Saknade settings i Google Sheet: ' + missing.join(', '));\n}\n\n// Convert budget from KR to cents (öre)\nconst budgetKr = parseFloat(settings.daily_budget);\nconst budgetCents = Math.round(budgetKr * 100);\n\n// Parse countries\nconst countries = settings.target_countries.split(',').map(c => c.trim().toUpperCase());\n\n// Use override URL if provided, otherwise use default from settings\nconst websiteUrl = formData.website_url_override || settings.website_url || '';\n\nif (!websiteUrl) {\n  throw new Error('Website URL saknas - ange i formuläret eller i Settings');\n}\n\n// Build final data object\nreturn [{\n  json: {\n    // From form\n    folder_id: formData.folder_id,\n    folder_url: formData.folder_url,\n    campaign_id: formData.campaign_id,\n    primary_text: formData.primary_text,\n    headline: formData.headline,\n    description: formData.description,\n    call_to_action: formData.call_to_action,\n    submission_time: formData.submission_time,\n    \n    // From settings\n    ad_account_id: settings.ad_account_id.replace('act_', ''),\n    facebook_page_id: settings.facebook_page_id,\n    pixel_id: settings.pixel_id,\n    \n    // Budget (converted)\n    daily_budget_kr: budgetKr,\n    daily_budget_cents: budgetCents,\n    \n    // Targeting\n    target_countries: countries,\n    \n    // Ad Set config\n    optimization_goal: settings.optimization_goal || 'OFFSITE_CONVERSIONS',\n    conversion_event: settings.conversion_event || 'PURCHASE',\n    bid_strategy: settings.bid_strategy || 'LOWEST_COST_WITHOUT_CAP',\n    \n    // Creative\n    website_url: websiteUrl,\n    \n    // Slack\n    slack_channel: settings.slack_channel || ''\n  }\n}];"
      },
      "id": "merge-settings",
      "name": "Merge Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 400]
