        "jsCode": "const items = $input.all();\nconst formData = $('Format Ad Copy').first().json;\n\nreturn items.map(item => {\n  // Generate formatted name for the ad\n  const timestamp = new Date().toISOString().slice(0, 10).replace(/-/g, '');\n  const cleanName = item.json.clean_name;\n  const adName = `${formData.campaign_name}_Video_${cleanName}_${timestamp}`;\n  \n  return {\n    json: {\n      ...item.json,\n      ad_name: adName,\n      media_type: 'video',\n      form_data: formData\n    },\n    binary: item.binary\n  };\n});"
      },
