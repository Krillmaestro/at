    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst validItems = [];\nconst invalidItems = [];\n\n// Naming convention check: alphanumeric, underscores, hyphens, dots\nconst validNameRegex = /^[a-zA-Z0-9_\\-\\.\\s]+\\.(jpg|jpeg|png|webp|mp4|mov)$/i;\n\n// Max file sizes (in bytes)\nconst MAX_IMAGE_SIZE = 30 * 1024 * 1024; // 30MB\nconst MAX_VIDEO_SIZE = 4 * 1024 * 1024 * 1024; // 4GB\n\nfor (const item of items) {\n  const name = item.json.name;\n  const size = parseInt(item.json.size) || 0;\n  const mimeType = item.json.mimeType;\n  const isVideo = mimeType.includes('video');\n  \n  let isValid = true;\n  let errorReason = '';\n  \n  // Check naming convention\n  if (!validNameRegex.test(name)) {\n    isValid = false;\n    errorReason = 'Invalid filename format';\n  }\n  \n  // Check file size\n  if (isVideo && size > MAX_VIDEO_SIZE) {\n    isValid = false;\n    errorReason = 'Video exceeds 4GB limit';\n  } else if (!isVideo && size > MAX_IMAGE_SIZE) {\n    isValid = false;\n    errorReason = 'Image exceeds 30MB limit';\n  }\n  \n  if (isValid) {\n    validItems.push({\n      json: {\n        ...item.json,\n        is_video: isVideo,\n        clean_name: name.replace(/\\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_\\-]/g, '_')\n      }\n    });\n  } else {\n    invalidItems.push({\n      json: {\n        ...item.json,\n        error_reason: errorReason\n      }\n    });\n  }\n}\n\n// Return valid items on output 0, invalid on output 1\nreturn [validItems, invalidItems];"
      },
      "id": "check-naming",
      "name": "Check Naming",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 300],
      "outputs": ["Valid Files", "Invalid Files"]
    },
