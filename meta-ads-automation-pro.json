      "name": "Has Files?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "jsCode": "const files = $input.all();\nconst folderData = $('Prepare Folders').item.json;\n\nconst MAX_IMAGE_SIZE = 30 * 1024 * 1024;\nconst MAX_VIDEO_SIZE = 4 * 1024 * 1024 * 1024;\n\nconst validFiles = [];\n\nfor (const file of files) {\n  const name = file.json.name;\n  const size = parseInt(file.json.size) || 0;\n  const mimeType = file.json.mimeType;\n  const isVideo = mimeType.includes('video');\n  \n  if (isVideo && size > MAX_VIDEO_SIZE) continue;\n  if (!isVideo && size > MAX_IMAGE_SIZE) continue;\n  \n  // Creative name = filename without extension\n  const creativeName = name.replace(/\\.[^/.]+$/, '').trim();\n  \n  validFiles.push({\n    json: {\n      file_id: file.json.id,\n      file_name: name,\n      creative_name: creativeName,\n      mime_type: mimeType,\n      is_video: isVideo,\n      size: size,\n      folder_id: folderData.folder_id,\n      folder_name: folderData.folder_name,\n      adset_name: folderData.adset_name,\n      config: folderData.config\n    }\n  });\n}\n\nif (validFiles.length === 0) {\n  throw new Error(`Inga giltiga filer i mappen: ${folderData.folder_name}`);\n}\n\nreturn validFiles;"
      },
