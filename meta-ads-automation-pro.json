      "parameters": {
        "jsCode": "const folders = $input.all();\n\nconst totalAds = folders.reduce((sum, f) => sum + f.json.ads.length, 0);\nconst totalAdSets = folders.length;\nconst config = folders[0].json.config;\n\nconst summary = folders.map(f => \n  `• ${f.json.adset_name}: ${f.json.ads.length} annonser`\n).join('\\n');\n\nreturn [{\n  json: {\n    total_ads: totalAds,\n    total_adsets: totalAdSets,\n    daily_budget_kr: config.daily_budget_kr,\n    campaign_id: config.campaign_id,\n    summary: summary,\n    folders: folders.map(f => f.json),\n    slack_channel: config.slack_channel\n  }\n}];"
