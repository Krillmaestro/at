      "id": "check-folder-access",
      "name": "Check Folder Access",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst formData = $('Merge Settings').first().json;\nconst validItems = [];\nconst invalidItems = [];\n\n// Naming convention check\nconst validNameRegex = /^[a-zA-Z0-9_\\-\\.\\s\\åäöÅÄÖ]+\\.(jpg|jpeg|png|webp|mp4|mov)$/i;\n\n// Max file sizes\nconst MAX_IMAGE_SIZE = 30 * 1024 * 1024;\nconst MAX_VIDEO_SIZE = 4 * 1024 * 1024 * 1024;\n\nfor (const item of items) {\n  const name = item.json.name;\n  const size = parseInt(item.json.size) || 0;\n  const mimeType = item.json.mimeType;\n  const isVideo = mimeType.includes('video');\n  \n  let isValid = true;\n  let errorReason = '';\n  \n  if (!validNameRegex.test(name)) {\n    isValid = false;\n    errorReason = 'Invalid filename format';\n  }\n  \n  if (isVideo && size > MAX_VIDEO_SIZE) {\n    isValid = false;\n    errorReason = 'Video exceeds 4GB limit';\n  } else if (!isVideo && size > MAX_IMAGE_SIZE) {\n    isValid = false;\n    errorReason = 'Image exceeds 30MB limit';\n  }\n  \n  if (isValid) {\n    validItems.push({\n      json: {\n        ...item.json,\n        is_video: isVideo,\n        clean_name: name.replace(/\\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_\\-]/g, '_'),\n        form_data: formData\n      }\n    });\n  } else {\n    invalidItems.push({\n      json: {\n        ...item.json,\n        error_reason: errorReason\n      }\n    });\n  }\n}\n\nreturn [validItems, invalidItems];"
      },
      "id": "check-naming",
      "name": "Check Naming",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 300],
      "outputs": ["Valid Files", "Invalid Files"]
    },
