        "jsCode": "const item = $input.first();\nconst previousItem = $('Loop Over Videos').first().json;\n\nreturn [{\n  json: {\n    video_id: item.json.id,\n    ad_name: previousItem.ad_name,\n    media_type: 'video',\n    original_filename: previousItem.name,\n    form_data: previousItem.form_data\n  }\n}];"
