# Meta Ads Automation - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SUPABASE (Required)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# META / FACEBOOK (Required)
# ===========================================
# Get these from https://developers.facebook.com/
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
# Long-lived access token with ads_management, business_management permissions
META_ACCESS_TOKEN=your-access-token

# ===========================================
# GOOGLE (Required for Drive integration)
# ===========================================
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
# OAuth refresh token for Drive access
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Or use a direct access token (expires)
GOOGLE_ACCESS_TOKEN=your-access-token

# ===========================================
# AI SERVICES (Required for AI analysis)
# ===========================================
# OpenAI - for image analysis (GPT-4 Vision)
# Get from https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-key

# Google AI - for video analysis (Gemini)
# Get from https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-gemini-api-key

# ===========================================
# NOTIFICATIONS (Optional)
# ===========================================
# Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for scheduled job verification
CRON_SECRET=your-random-secret-string
